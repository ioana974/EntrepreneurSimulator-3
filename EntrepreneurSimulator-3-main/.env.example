# Environment Variables for EntrepreneurSimulator
# Copy this file to .env and fill in the values

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (Firebase - no MongoDB needed)
# Firebase service account key should be in firebase-key.json

# Authentication
JWT_SECRET=your_jwt_secret_here_generate_random_string

# Email Configuration (Choose one method)

# Method 1: Gmail SMTP
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_SERVICE=gmail
EMAIL_FROM=your_gmail@gmail.com

# Method 2: SendGrid API
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Admin Email (where results are sent)
ADMIN_EMAIL=your_admin_email@gmail.com

# OpenAI (optional, for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Legacy MongoDB (not used with Firebase)
MONGODB_URI=mongodb://localhost:27017/entrepreneur-simulator
REACT_APP_LANGUAGE=ro

# Logging
LOG_LEVEL=debug
